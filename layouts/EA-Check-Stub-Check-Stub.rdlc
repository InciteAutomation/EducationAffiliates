                      <CellContents>
                        <!--
 BODY REFNBR LOOKUP
 ==================
 This textbox intentionally uses a native RDLC Switch expression rather than
 Code.GetRefNbr.

 Business Central rejected the previous Code.GetRefNbr reference during layout
 validation, even though the function was present in the embedded VB block.

 The Switch expression compares the effective visible invoice number against
 all 100 External Document No. and RefNbr mappings, then returns the matching
 RefNbr. This avoids the custom-function validation problem while retaining
 the full 100-entry lookup capacity.

 EffectiveBodyDocNo is still used to repair Business Central split rows where
 the document number is on the preceding zero-amount record.
--><Textbox Name="RefNbr">
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(
    Len(Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value))))) = 0,
    Nothing,
    Switch(
        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo1.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo1.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo1.Value, "Table1_Group1"))),
        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo2.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo2.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo2.Value, "Table1_Group1"))),
        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo3.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo3.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo3.Value, "Table1_Group1"))),
        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo4.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo4.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo4.Value, "Table1_Group1"))),
