  <!--
 EMBEDDED VISUAL BASIC
 =====================
 Reporting Services executes the following VB functions during rendering.
 Comments beginning with an apostrophe are VB comments and are safe.

 The code separates:
   * 10 physical detail rows per printed page, from
   * 100 available RefNbr lookup mappings across the complete payment.
--><Code>
'==============================================================================
' EA CHECK CUSTOM CODE
'==============================================================================
'
' This code supports:
'   1. Number/date formatting.
'   2. Split-row repair for unselected check printing.
'   3. Logical footer-row construction.
'   4. Footer row construction and formatting support.
'
' FooterInfo uses Chr(177) as its delimiter.
'
' STANDARD PHYSICAL STUB CAPACITY
' ===============================
' Business Central supplies 10 physical Stub2 rows per printed page. The
' LogicalFooter* functions therefore continue to work with logical rows 1-10
' for each page. The 100-entry mapping table is searched independently so
' continuation pages can resolve RefNbrs beyond mapping index 10.
'
' MAINTENANCE WARNING
' ===================
' FooterInfo positions 1-114 are inherited from the prior layout. Custom
' positions 115-414 are documented in LogicalFooterRefNbr.
'
' The body RefNbr textbox uses a native RDLC Switch expression.
' It does not call a custom GetRefNbr function.
'==============================================================================

Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function FormatWrittenAmount(ByVal footerInfo As String) As String
    Dim parts() As String = Split(footerInfo, ChrW(177))
    Dim result As String = ""

    If parts Is Nothing OrElse parts.Length &lt;= 96 Then
        Return ""
    End If

    result = Trim(CStr(parts(96)))

    'Remove leading asterisks.
    While result.StartsWith("*")
        result = result.Substring(1)
    End While

    result = Trim(result)

    'Remove US DOLLARS from the end.
    If UCase(result).EndsWith(" US DOLLARS") Then
        result = Trim(result.Substring(0, result.Length - 11))
    End If

    'Remove DOLLARS from the end if it remains.
    If UCase(result).EndsWith(" DOLLARS") Then
        result = Trim(result.Substring(0, result.Length - 8))
    End If

    'Remove US from the end if it remains.
    If UCase(result).EndsWith(" US") Then
        result = Trim(result.Substring(0, result.Length - 3))
    End If

    'Change 0/100 to 00/100.
    If result.EndsWith(" 0/100") Then
        result = result.Substring(0, result.Length - 6) &amp; " 00/100"
    End If

    'Add a space before the trailing dashes.
    result = result &amp; " "

    'Approximate number of Courier New 9pt characters
    'that fit inside the 7.15-inch textbox.
    Dim totalCharacters As Integer = 95

    If result.Length &lt; totalCharacters Then
        result = result.PadRight(totalCharacters, "-"c)
    End If

    Return result
End Function


Public Function JoinFooterRows(
    ByVal footerValue As String,
    ByVal firstPosition As Integer,
    ByVal rowCount As Integer,
    ByVal formatAsNumber As Boolean
) As String

    If String.IsNullOrEmpty(footerValue) Then
        Return ""
    End If

    Dim values() As String = Split(footerValue, Chr(177))
    Dim output As New System.Text.StringBuilder()

    For rowIndex As Integer = 0 To rowCount - 1
        Dim choosePosition As Integer = firstPosition + rowIndex
        Dim arrayIndex As Integer = choosePosition - 1
        Dim value As String = ""

        If arrayIndex &gt;= 0 AndAlso arrayIndex &lt;= UBound(values) Then
            value = Trim(CStr(values(arrayIndex)))
        End If

        If formatAsNumber AndAlso value &lt;&gt; "" Then
            Dim numberValue As Decimal

            If Decimal.TryParse(value, numberValue) Then
                value = numberValue.ToString("#,##0.00")
            End If
        End If

        If rowIndex &gt; 0 Then
            output.Append(Chr(10))
        End If

        output.Append(value)
    Next

    Return output.ToString()
End Function


Public Function FooterText( _
    ByVal footerValue As String, _
    ByVal choosePosition As Integer _
) As String

    If String.IsNullOrEmpty(footerValue) Then
        Return ""
    End If

    Dim values() As String = Split(footerValue, Chr(177))
    Dim arrayIndex As Integer = choosePosition - 1

    If arrayIndex &lt; 0 OrElse arrayIndex &gt; UBound(values) Then
        Return ""
    End If

    Return Trim(CStr(values(arrayIndex)))
End Function


Public Function FooterDate( _
    ByVal footerValue As String, _
    ByVal choosePosition As Integer _
) As String

    Dim value As String =
        FooterText(footerValue, choosePosition)

    If value = "" Then
        Return ""
    End If

    Dim parsedDate As DateTime

    If DateTime.TryParse(value, parsedDate) Then
        Return parsedDate.ToString("MM/dd/yy")
    End If

    Return ""
End Function


Public Function FooterNumber( _
    ByVal footerValue As String, _
    ByVal choosePosition As Integer _
) As String

    Dim value As String =
        FooterText(footerValue, choosePosition)

    If value = "" Then
        Return ""
    End If

    Dim parsedNumber As Decimal

    If Decimal.TryParse(value, parsedNumber) Then
        Return parsedNumber.ToString("#,##0.00")
    End If

    Return ""
End Function


Public Function LastPopulatedFooterRow( _
    ByVal footerValue As String _
) As Integer

    If String.IsNullOrEmpty(footerValue) Then
        Return 0
    End If

    'Invoice Nbr values occupy positions 125 through 134.
    For rowNumber As Integer = 10 To 1 Step -1

        Dim invoicePosition As Integer = 124 + rowNumber

        If FooterText(footerValue, invoicePosition) &lt;&gt; "" Then
            Return rowNumber
        End If

    Next

    Return 0
End Function

Public Function FooterTotalForRow( _
    ByVal footerValue As String, _
    ByVal currentRow As Integer _
) As String

    If LastPopulatedFooterRow(footerValue) &lt;&gt; currentRow Then
        Return ""
    End If

    Return FooterNumber(footerValue, 74)
End Function

Public Function FooterNumberForRow( _
    ByVal footerValue As String, _
    ByVal currentRow As Integer, _
    ByVal numberPosition As Integer _
) As String

    Dim invoicePosition As Integer = 124 + currentRow

    If FooterText(footerValue, invoicePosition) = "" Then
        Return ""
    End If

    Return FooterNumber(footerValue, numberPosition)
End Function

Public Function EffectiveBodyDocNo( _
    ByVal currentDocNo As Object, _
    ByVal previousDocNo As Object _
) As String

    Dim currentValue As String = Trim(CStr(currentDocNo))

    If currentValue &lt;&gt; "" Then
        Return currentValue
    End If

    Return Trim(CStr(previousDocNo))
End Function

Private Function FooterRawNumber( _
    ByVal footerValue As String, _
    ByVal choosePosition As Integer _
) As Decimal

    Dim value As String = FooterText(footerValue, choosePosition)

    If value = "" Then
        Return 0D
    End If

    value = Replace(value, "$", "")
    value = Replace(value, ",", "")
    value = Trim(value)

    Dim parsedValue As Decimal

    If Decimal.TryParse(value, parsedValue) Then
        Return parsedValue
    End If

    Return 0D
End Function

Private Function LogicalFooterSourceIndex( _
    ByVal footerValue As String, _
    ByVal logicalRow As Integer _
) As Integer

    If logicalRow &lt; 1 Then
        Return 0
    End If

    Dim foundRows As Integer = 0

    For rawRow As Integer = 1 To 10
        ' Stub2LineAmount_1_ through Stub2LineAmount_10_
        ' occupy FooterInfo positions 63 through 72.
        If FooterRawNumber(footerValue, 62 + rawRow) &lt;&gt; 0D Then
            foundRows += 1

            If foundRows = logicalRow Then
                Return rawRow
            End If
        End If
    Next

    Return 0
End Function

Private Function LogicalFooterCount( _
    ByVal footerValue As String _
) As Integer

    Dim count As Integer = 0

    For rawRow As Integer = 1 To 10
        If FooterRawNumber(footerValue, 62 + rawRow) &lt;&gt; 0D Then
            count += 1
        End If
    Next

    Return count
End Function

Private Function EffectiveFooterDocNoBySource( _
    ByVal footerValue As String, _
    ByVal sourceRow As Integer _
) As String

    If sourceRow &lt; 1 Then
        Return ""
    End If

    ' Stub2DocNo_1_ through Stub2DocNo_10_
    ' occupy FooterInfo positions 13 through 22.
    Dim value As String = FooterText(footerValue, 12 + sourceRow)

    If value &lt;&gt; "" Then
        Return value
    End If

    ' In unselected mode, Business Central may place the document number
    ' on the preceding zero-amount dataset row and the paid amount on the
    ' following row. Walk backward to combine them into one printed line.
    For previousRow As Integer = sourceRow - 1 To 1 Step -1
        value = FooterText(footerValue, 12 + previousRow)

        If value &lt;&gt; "" Then
            Return value
        End If
    Next

    Return ""
End Function

Private Function EffectiveFooterDateBySource( _
    ByVal footerValue As String, _
    ByVal sourceRow As Integer _
) As String

    If sourceRow &lt; 1 Then
        Return ""
    End If

    ' Stub2DocDate_1_ through Stub2DocDate_10_
    ' occupy FooterInfo positions 23 through 32.
    Dim value As String = FooterDate(footerValue, 22 + sourceRow)

    If value &lt;&gt; "" Then
        Return value
    End If

    For previousRow As Integer = sourceRow - 1 To 1 Step -1
        value = FooterDate(footerValue, 22 + previousRow)

        If value &lt;&gt; "" Then
            Return value
        End If
    Next

    Return ""
End Function

Public Function LogicalFooterInvoiceNbr( _
    ByVal footerValue As String, _
    ByVal logicalRow As Integer _
) As String

    Dim sourceRow As Integer =
        LogicalFooterSourceIndex(footerValue, logicalRow)

    Return EffectiveFooterDocNoBySource(footerValue, sourceRow)
End Function

Public Function LogicalFooterDate( _
    ByVal footerValue As String, _
    ByVal logicalRow As Integer _
) As String

    Dim sourceRow As Integer =
        LogicalFooterSourceIndex(footerValue, logicalRow)

    Return EffectiveFooterDateBySource(footerValue, sourceRow)
End Function

Public Function LogicalFooterInvoiceAmount( _
    ByVal footerValue As String, _
    ByVal logicalRow As Integer _
) As String

    Dim sourceRow As Integer =
        LogicalFooterSourceIndex(footerValue, logicalRow)

    If sourceRow = 0 Then
        Return ""
    End If

    ' Existing layout uses Stub2LineAmount for both Invoice Amount
    ' and Amount Paid.
    Return FooterNumber(footerValue, 62 + sourceRow)
End Function

Public Function LogicalFooterAmountPaid( _
    ByVal footerValue As String, _
    ByVal logicalRow As Integer _
) As String

    Return LogicalFooterInvoiceAmount(footerValue, logicalRow)
End Function

Public Function LogicalFooterDiscount( _
    ByVal footerValue As String, _
    ByVal logicalRow As Integer _
) As String

    Dim sourceRow As Integer =
        LogicalFooterSourceIndex(footerValue, logicalRow)

    If sourceRow = 0 Then
        Return ""
    End If

    ' Stub2LineDiscount_1_ through Stub2LineDiscount_10_
    ' occupy FooterInfo positions 53 through 62.
    Return FooterNumber(footerValue, 52 + sourceRow)
End Function

Public Function LogicalFooterNetCheckAmount( _
    ByVal footerValue As String, _
    ByVal logicalRow As Integer _
) As String

    If logicalRow &lt;&gt; LogicalFooterCount(footerValue) Then
        Return ""
    End If

    Return FooterNumber(footerValue, 74)
End Function


'==============================================================================
' PAGE-FOOTER REFNBR MATCHING
'==============================================================================
'
' FooterInfo position map:
'   115-214 = RefNbr mappings 1-100
'   215-314 = Invoice Nbr mappings 1-100
'   315-414 = Invoice date mappings 1-100
'
' The hidden FooterInfo textbox serializes these custom values using
' First(field, "Table1_Group1") so the same complete mapping set is
' available to every physical check and continuation-page footer.
'
' The footer's visible invoice number is compared against all 100 mappings.
' Every documentation line in this embedded-code section must begin with an
' apostrophe so Reporting Services treats it as a VB comment.
'==============================================================================

Public Function LogicalFooterRefNbr( _
    ByVal footerValue As String, _
    ByVal logicalRow As Integer _
) As String

    Dim currentInvoiceNbr As String =
        LogicalFooterInvoiceNbr(footerValue, logicalRow)

    If currentInvoiceNbr = "" Then
        Return ""
    End If

    For mappingRow As Integer = 1 To 100
        Dim refNbrPosition As Integer =
            114 + mappingRow

        Dim invoiceNbrPosition As Integer =
            214 + mappingRow

        Dim refNbr As String =
            FooterText(footerValue, refNbrPosition)

        Dim invoiceNbr As String =
            FooterText(footerValue, invoiceNbrPosition)

        If refNbr &lt;&gt; "" Then
            If String.Equals(
                currentInvoiceNbr,
                invoiceNbr,
                StringComparison.OrdinalIgnoreCase
            ) OrElse String.Equals(
                currentInvoiceNbr,
                refNbr,
                StringComparison.OrdinalIgnoreCase
            ) Then
                Return refNbr
            End If
        End If
    Next

    Return ""
End Function
