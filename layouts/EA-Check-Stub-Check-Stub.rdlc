                  <Height>0.03125in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <!--
 FOOTERINFO TRANSPORT STRING
 ===========================
 Page footers cannot directly access arbitrary dataset rows. This hidden
 textbox serializes standard check fields and all 100 custom mapping values
 into one Chr(177)-delimited string.

 Do not reorder positions 1-114 unless every existing FooterText position in
 the embedded VB code is updated. Custom mappings begin at position 115.
--><!--
 BOTTOM REFNBR FIX
 =================
 Custom mappings 1-100 are serialized with
 First(Field, "Table1_Group1"), matching the working body-row scope.

 This prevents the page footer from receiving blank RefNbr and invoice lookup
 values when the standard report creates selected/overflow check pages.
--><Textbox Name="FooterInfo">
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Last(Fields!TotalText.Value) + Chr(177)
 + Cstr(Last(Fields!TotalLineAmount.Value)) + Chr(177)
 + Last(Fields!CheckToAddr_1_.Value) + Chr(177)
 + Last(Fields!CheckDateText.Value) + Chr(177)
 + Last(Fields!CheckNoText_Control1480000Caption.Value) + Chr(177)
 + Cstr(Last(Fields!CheckNoText_Control1480000.Value)) + Chr(177)
 + Last(Fields!Stub2DocNoHeader.Value) + Chr(177)
 + Last(Fields!Stub2DocDateHeader.Value) + Chr(177)
 + Last(Fields!Stub2PostingDescHeader.Value) + Chr(177)
 + Last(Fields!Stub2AmountHeader.Value) + Chr(177)
 + Last(Fields!Stub2DiscountHeader.Value) + Chr(177)
 + Last(Fields!Stub2NetAmountHeader.Value) + Chr(177)
 + Cstr(Last(Fields!Stub2DocNo_1_.Value)) + Chr(177)
 + Cstr(Last(Fields!Stub2DocNo_2_.Value)) + Chr(177)
 + Cstr(Last(Fields!Stub2DocNo_3_.Value)) + Chr(177)
 + Cstr(Last(Fields!Stub2DocNo_4_.Value)) + Chr(177)
