        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo6.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo6.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo6.Value, "Table1_Group1"))),
        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo7.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo7.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo7.Value, "Table1_Group1"))),
        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo8.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo8.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo8.Value, "Table1_Group1"))),
        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo9.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo9.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo9.Value, "Table1_Group1"))),
        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo10.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo10.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo10.Value, "Table1_Group1"))),
        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo11.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo11.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo11.Value, "Table1_Group1"))),
        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo12.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo12.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo12.Value, "Table1_Group1"))),
        (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterExternalDocumentNo13.Value, "Table1_Group1")))) OR (Trim(CStr(Code.EffectiveBodyDocNo(Fields!DocNo.Value, Previous(Fields!DocNo.Value)))) = Trim(CStr(First(Fields!EAFooterAppliesToDocNo13.Value, "Table1_Group1")))), Trim(CStr(First(Fields!EAFooterAppliesToDocNo13.Value, "Table1_Group1"))),
