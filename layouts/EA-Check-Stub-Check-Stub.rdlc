                    <TablixCell>
                      <CellContents>
                        <Textbox Name="LineAmount">
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(
                                    Len(Trim(CStr(Fields!PostingDesc.Value))) &gt; 0
                                    AND
                                    RunningValue(
                                        IIF(
                                            Len(Trim(CStr(Fields!PostingDesc.Value))) &gt; 0,
                                            1,
                                            0
                                        ),
                                        Sum,
                                        "Table1_Group1"
                                    )
                                    =
                                    Sum(
                                        IIF(
                                            Len(Trim(CStr(Fields!PostingDesc.Value))) &gt; 0,
                                            1,
                                            0
                                        ),
                                        "Table1_Group1"
                                    ),
                                    Last(
                                        Fields!TotalLineAmount.Value,
                                        "Table1_Group1"
                                    ),
                                    Nothing
                                )</Value>
                                  <Style>
                                    <FontFamily>Courier New</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <Format>=Last(Fields!TotalLineAmountFormat.Value, "Table1_Group1")</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                              </Style>
